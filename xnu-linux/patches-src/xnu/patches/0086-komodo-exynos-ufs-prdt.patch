-	utrd->resp = (512u / 4) << 16 | (512u / 4);
+	const uint32_t chunk_max = su.exynos ? PRDT_CHUNK_EXYNOS : PRDT_CHUNK;
+	const uint32_t stride = su.exynos ? su.prdt_stride : 16u;
+	/* response UPIU at 512, 512 bytes long; PRDT at 1024 */
