 #include <stdint.h>
 #include <kern/misc_protos.h>
 
-static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0xf0000000 /* TEGU-TODO: runtime fb address, patch from live FDT at boot */;
+/*
+ * komodo: the framebuffer is not at a fixed address on Tensor (CMA, chosen by
+ * the bootloader at runtime). tegu_early_set_fb() takes it from boot_args->
+ * Video (the shim reads it from the DPU). Until then the console is off.
+ * Only one 32MB block is mapped (start.s / arm_vm_init), so the usable height
+ * is clipped to what fits in that block: a write past it would fault inside
+ * the panic path.
+ */
+#define EARLY_BLOCK_SIZE (1ull << 25)   /* ARM_16K_TT_L2_SIZE */
+static volatile uint32_t *early_fb;
+static uint64_t early_fb_pa;
+static unsigned int early_width = 1344u, early_height = 2992u, early_stride = 1344u;
 #define EARLY_FB early_fb
-#define EARLY_WIDTH 1080u
-#define EARLY_HEIGHT 2406u
-#define EARLY_STRIDE (4320u / 4)
-#define EARLY_SCALE 2u
+#define EARLY_WIDTH early_width
+#define EARLY_HEIGHT early_height
+#define EARLY_STRIDE early_stride
+#define EARLY_SCALE 3u                  /* 24x48 cells: legible on a phone photo */
 #define EARLY_CELL_W (8u * EARLY_SCALE)
 #define EARLY_CELL_H (16u * EARLY_SCALE)
 #define EARLY_ROWS ((EARLY_HEIGHT - 32u) / EARLY_CELL_H)
@@ -40,9 +51,40 @@
