komodo: early framebuffer console at the runtime address from boot_args

tegu hard-codes the Redmi framebuffer (PA 0xf0000000, 1080x2406, marked
TEGU-TODO). On Tensor the bootloader framebuffer is CMA at a runtime address;
the komodo shim reads it from DPP0 and passes it in boot_args->Video. Use that
for the stage-0 band, the VA=PA bootstrap block, the final alias and the
console geometry (1344x2992), clipped to the one mapped 32MB block.

--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -515,10 +515,13 @@
 
 #if defined(TEGU)
 	/* Stage 0: white 64x32 band, no stack or page tables needed. */
-	MOV64	x0, (0xf0000000 /* TEGU-TODO: runtime fb address, patch from live FDT at boot */ + 2368 * 4320)
+	/* komodo: the framebuffer comes from boot_args->Video, which the shim
+	 * fills from the DPU (DPP0 RDMA base). Band at the top-left corner. */
+	ldr		x0, [x20, #40]				// Video.v_baseAddr (PA)
+	ldr		x4, [x20, #56]				// Video.v_rowBytes
+	cbz		x0, Ltegu_mark_done			// no framebuffer: skip
 	mov		w1, #-1
 	mov		x2, #32
-	mov		x4, #4320
 Ltegu_mark_row:
 	mov		x3, #64
 	mov		x5, x0
@@ -529,6 +532,7 @@
 	add		x0, x0, x4
 	subs	x2, x2, #1
 	b.ne	Ltegu_mark_row
+Ltegu_mark_done:
 	dsb		sy
 #endif
 
@@ -686,7 +690,9 @@
 	 * TEGU uses 16K pages and all bring-up RAM is below 4GB, so the first
 	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
 	 */
-	MOV64	x10, 0xf0000000 /* TEGU-TODO: runtime fb address, patch from live FDT at boot */
+	ldr		x10, [x20, #40]				// komodo: Video.v_baseAddr
+	lsr		x10, x10, #(ARM_TT_L2_SHIFT)		// round down to the
+	lsl		x10, x10, #(ARM_TT_L2_SHIFT)		// containing 32MB block
 	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 	orr		x11, x11, x10
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
