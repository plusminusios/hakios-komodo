 void
+tegu_early_set_fb(uint64_t pa, uint64_t row_bytes, uint64_t width, uint64_t height)
+{
+	if (pa == 0 || row_bytes < 4 || width == 0 || height < 64) {
+		return;
+	}
+	uint64_t room = EARLY_BLOCK_SIZE - (pa & (EARLY_BLOCK_SIZE - 1));
+	if (height > room / row_bytes) {
+		height = room / row_bytes;
+	}
+	if (width > row_bytes / 4) {
+		width = row_bytes / 4;
+	}
+	if (height < 64) {
+		return;
+	}
+	early_fb_pa = pa;
+	early_stride = (unsigned int)(row_bytes / 4);
+	early_width = (unsigned int)width;
+	early_height = (unsigned int)height;
+	/* start.s maps the containing block VA=PA until arm_vm_init relocates. */
+	early_fb = (volatile uint32_t *)(uintptr_t)pa;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+uint64_t
+tegu_early_fb_pa(void)
+{
+	return early_fb_pa;
+}
